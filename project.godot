; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

name="شبیه‌ساز کشور"
config/version="5.0.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.2", "Mobile")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.05, 0.08, 0.15, 1)

[autoload]

BalanceConfig="*res://scripts/core/balance_config.gd"
WorldManager="*res://scripts/core/world_manager.gd"
TechnologyManager="*res://scripts/core/technology_manager.gd"
ScenarioManager="*res://scripts/core/scenario_manager.gd"
PolicyManager="*res://scripts/core/policy_manager.gd"
AnalyticsManager="*res://scripts/core/analytics_manager.gd"
TimeManager="*res://scripts/core/time_manager.gd"
SeasonalManager="*res://scripts/core/seasonal_manager.gd"
ReportManager="*res://scripts/core/report_manager.gd"
MilitaryManager="*res://scripts/core/military_manager.gd"
NationalProjectManager="*res://scripts/core/national_project_manager.gd"
CabinetManager="*res://scripts/core/cabinet_manager.gd"
AuditManager="*res://scripts/core/audit_manager.gd"
LawManager="*res://scripts/core/law_manager.gd"
IntelligenceOperationManager="*res://scripts/core/intelligence_operation_manager.gd"
GeographyManager="*res://scripts/core/geography_manager.gd"
MapLayerManager="*res://scripts/core/map_layer_manager.gd"
GameState="*res://scripts/core/state.gd"
GameEngine="*res://scripts/core/engine.gd"
EventLog="*res://scripts/core/event_log.gd"
SaveManager="*res://scripts/core/save_manager.gd"
Deterministic="*res://scripts/core/deterministic.gd"
AIAdvisor="*res://scripts/ai/ai_advisor.gd"
SettingsManager="*res://scripts/core/settings_manager.gd"
PersianFormatter="*res://scripts/ui/persian_formatter.gd"
FeedbackManager="*res://scripts/ui/feedback_manager.gd"
MultiplayerCampaignManager="*res://scripts/multiplayer/multiplayer_campaign_manager.gd"
P2PManager="*res://scripts/multiplayer/p2p_manager.gd"

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/size/mode=2
window/size/resizable=true
window/handheld/orientation=1
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input]

ui_accept={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":0,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":0,"key_label":0,"unicode":0,"echo":false,"script":null)
, Object(InputEventJoypadButton,"resource_local_to_scene":false,"resource_name":"","device":0,"button_index":0,"pressure":0.0,"pressed":false,"pressure_pressed":false,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"script":null)
